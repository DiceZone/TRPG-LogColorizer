{
  "engine": 1,
  "id": "terminal",
  "name": "终端",
  "version": "1.0.0",
  "author": "TRPG-LogColorizer",
  "description": "等宽字体与绿色荧光，只有深色",
  "modes": ["dark"],
  "layout": "workspace",
  "tokens": {
    "dark": {
      "--lc-bg": "#080b09",
      "--lc-surface": "#0d1310",
      "--lc-surface-raised": "#111a15",
      "--lc-surface-sunken": "#0a0f0c",
      "--lc-text": "#cfe9d6",
      "--lc-text-muted": "#7fa38a",
      "--lc-text-faint": "#4f6b58",
      "--lc-border": "#1c2a21",
      "--lc-border-strong": "#2b4133",
      "--lc-primary": "#5fdc8e",
      "--lc-primary-hover": "#7de8a5",
      "--lc-primary-pressed": "#48c478",
      "--lc-primary-contrast": "#06110a",
      "--lc-primary-soft": "#12261a",
      "--lc-danger": "#ff7a59",
      "--lc-live": "#ff5f56",
      "--lc-input-bg": "#0a0f0c",
      "--lc-editor-bg": "#0a0f0c",
      "--lc-editor-text": "#cfe9d6",
      "--lc-editor-gutter-bg": "#0d1310",
      "--lc-editor-gutter-border": "#1c2a21",
      "--lc-editor-active-line": "#111a15",
